# Katalogi z mediami (montowane tylko do odczytu), oddzielone srednikiem.
# Wpis: [TYP:]SCIEZKA, TYP = V (wideo), A (audio), P (zdjecia) lub polaczenie, np. AV.
# Bez TYPU indeksowane sa wszystkie rodzaje plikow.
# W kliencie DLNA katalog widac pod nazwa ostatniego czlonu sciezki.
# Przyklad: MEDIA_DIRS="V:/media/havoc/swap;A:/home/havoc/Muzyka;P:/home/havoc/Obrazy"
MEDIA_DIRS="V:/media/havoc/swap"
# UID/GID uzytkownika, z ktorego prawami dziala minidlna (wynik `id -u` / `id -g`)
PUID=1000
PGID=1000
